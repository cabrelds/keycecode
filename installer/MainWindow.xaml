<Window x:Class="KeyCodeSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation — KeyCode IDE 2.0"
        Width="600" Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#CCCCCC"
        Icon="pack://application:,,,/KeyCodeSetup;component/Assets/keycode.ico">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BoutonPrimaire" TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="#1177BB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fond" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonSecondaire" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333337" BorderThickness="0,0,0,1" Padding="24,18">
            <DockPanel>
                <Border Background="#007ACC" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0">
                    <TextBlock Text="&lt;/&gt;" Foreground="White" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KeyCode IDE — Version 2.0" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Éditeur de code moderne style VS Code avec exécution multi-langages et assistant Gemini AI"
                               FontSize="11.5" Foreground="#9D9D9D" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Corps de l'assistant -->
        <Grid Grid.Row="1" Margin="24,20">
            <!-- Étape 1 : Configuration -->
            <StackPanel x:Name="PanneauConfig">
                <TextBlock Text="Dossier d'installation" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                <Grid Margin="0,6,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChampDossier"
                             Grid.Column="0"
                             Background="#3C3C3C" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                             BorderBrush="#555555" BorderThickness="1"
                             Padding="8,7" FontSize="12"/>
                    <Button Grid.Column="1" Content="Parcourir..." Margin="8,0,0,0"
                            Style="{StaticResource BoutonSecondaire}"
                            Click="Parcourir_Click"/>
                </Grid>

                <TextBlock Text="Options d'intégration Windows" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,4"/>
                <CheckBox x:Name="OptBureau" Content="Créer un raccourci sur le Bureau" IsChecked="True"/>
                <CheckBox x:Name="OptMenuDemarrer" Content="Ajouter au menu Démarrer Windows" IsChecked="True"/>
                <CheckBox x:Name="OptMenuContextuel" Content="Ajouter « Ouvrir avec KeyCode » au clic droit sur fichiers et dossiers" IsChecked="True"/>

                <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4"
                        Padding="12,10" Margin="0,16,0,0">
                    <TextBlock x:Name="TexteInfoPayload"
                               FontSize="11.5" Foreground="#9D9D9D" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Étape 2 : Progression -->
            <StackPanel x:Name="PanneauProgression" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="TexteEtape" Text="Préparation de l'installation..."
                           FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                <ProgressBar x:Name="BarreProgression" Height="10" Minimum="0" Maximum="100" Value="10"
                             Foreground="#007ACC" Background="#333337" BorderThickness="0"/>
                <TextBlock x:Name="TexteJournal" Text="" FontSize="11.5" Foreground="#9D9D9D"
                           Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Étape 3 : Succès -->
            <StackPanel x:Name="PanneauTermine" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="✓ Installation terminée avec succès !"
                           FontSize="17" FontWeight="SemiBold" Foreground="#4EC9B0" Margin="0,0,0,8"/>
                <TextBlock x:Name="TexteResume" TextWrapping="Wrap" FontSize="12.5" Foreground="#CCCCCC" Margin="0,0,0,14"/>
                <CheckBox x:Name="OptLancer" Content="Lancer KeyCode maintenant" IsChecked="True"/>
            </StackPanel>
        </Grid>

        <!-- Pied de page -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#333337" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Équipe KeyCode (Keyce)" VerticalAlignment="Center"
                           Foreground="#858585" FontSize="11" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BoutonAnnuler" Content="Annuler" Margin="0,0,10,0"
                            Style="{StaticResource BoutonSecondaire}"
                            Click="Annuler_Click"/>
                    <Button x:Name="BoutonPrincipal" Content="Installer"
                            Style="{StaticResource BoutonPrimaire}"
                            Click="ActionPrincipale_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
