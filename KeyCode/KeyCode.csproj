<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\keycode.ico</ApplicationIcon>
    <AssemblyTitle>KeyCode</AssemblyTitle>
    <Product>KeyCode IDE</Product>
    <Version>2.0.0</Version>
    <Company>Équipe KeyCode</Company>
    <Description>Éditeur de code moderne style VS Code avec assistant IA Gemini</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\keycode.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

</Project>
