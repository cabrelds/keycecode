<Window x:Class="KeyCode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:KeyCode.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KeyceCode"
        Height="760" Width="1280" MinHeight="480" MinWidth="760"
        Background="{DynamicResource ThemeFond}"
        Foreground="{DynamicResource ThemeTexte}"
        Icon="pack://application:,,,/KeyCode;component/Assets/keycode.ico"
        AllowDrop="True" Drop="Fenetre_Drop"
        PreviewKeyDown="Fenetre_PreviewKeyDown"
        StateChanged="Fenetre_StateChanged"
        Closing="Fenetre_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BoutonBarreActivite" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexteSecondaire}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Indicateur" Width="2" HorizontalAlignment="Left" Background="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Actif">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
                                <Setter TargetName="Indicateur" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonFenetre" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="{DynamicResource ThemeSurvol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonFermerFenetre" TargetType="Button" BasedOn="{StaticResource BoutonFenetre}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonStatut" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBarreStatutTexte}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="#1F8AD2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="BordureRacine" BorderBrush="{DynamicResource ThemeBordure}" BorderThickness="1">
        <DockPanel>
            <!-- Barre de titre personnalisée style VS Code -->
            <Border DockPanel.Dock="Top" Height="34"
                    Background="{DynamicResource ThemeBarreTitre}"
                    BorderBrush="{DynamicResource ThemeBordure}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Menus -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/KeyCode;component/Assets/keycode.ico"
                               Width="22" Height="22" Margin="8,0,6,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"/>

                        <Menu shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                            <MenuItem Header="_Fichier">
                                <MenuItem Header="_Nouveau fichier" InputGestureText="Ctrl+N" Click="Nouveau_Click"/>
                                <MenuItem Header="_Ouvrir un fichier..." InputGestureText="Ctrl+O" Click="Ouvrir_Click"/>
                                <MenuItem Header="Ouvrir un _dossier..." Click="OuvrirDossier_Click"/>
                                <Separator/>
                                <MenuItem Header="_Enregistrer" InputGestureText="Ctrl+S" Click="Enregistrer_Click"/>
                                <MenuItem Header="Tout enregistrer" InputGestureText="Ctrl+Maj+S" Click="ToutEnregistrer_Click"/>
                                <Separator/>
                                <MenuItem Header="_Fermer l'onglet" InputGestureText="Ctrl+W" Click="FermerOnglet_Click"/>
                                <MenuItem Header="_Rouvrir l'onglet fermé" InputGestureText="Ctrl+Maj+T" Click="RouvrirOnglet_Click"/>
                                <MenuItem x:Name="MenuRecents" Header="Fichiers _récents"/>
                                <Separator/>
                                <MenuItem Header="_Paramètres..." Click="Parametres_Click"/>
                                <MenuItem Header="_Quitter" Click="Quitter_Click"/>
                            </MenuItem>
                            <MenuItem Header="_Édition">
                                <MenuItem Header="_Annuler" InputGestureText="Ctrl+Z" Click="Annuler_Click"/>
                                <MenuItem Header="_Rétablir" InputGestureText="Ctrl+Y" Click="Retablir_Click"/>
                                <Separator/>
                                <MenuItem Header="Co_uper" InputGestureText="Ctrl+X" Click="Couper_Click"/>
                                <MenuItem Header="_Copier" InputGestureText="Ctrl+C" Click="Copier_Click"/>
                                <MenuItem Header="C_oller" InputGestureText="Ctrl+V" Click="Coller_Click"/>
                                <Separator/>
                                <MenuItem Header="Tout _sélectionner" InputGestureText="Ctrl+A" Click="ToutSelectionner_Click"/>
                                <Separator/>
                                <MenuItem Header="_Rechercher" InputGestureText="Ctrl+F" Click="Rechercher_Click"/>
                                <MenuItem Header="Re_mplacer" InputGestureText="Ctrl+H" Click="Remplacer_Click"/>
                                <MenuItem Header="_Aller à la ligne..." InputGestureText="Ctrl+G" Click="AllerALigne_Click"/>
                                <MenuItem Header="Rechercher dans les _fichiers" InputGestureText="Ctrl+Maj+F" Click="RechercheFichiers_Click"/>
                                <MenuItem x:Name="MenuPrettier" Header="_Formater le document (Prettier)"
                                          InputGestureText="Maj+Alt+F" Click="Formater_Click" Visibility="Collapsed"/>
                            </MenuItem>
                            <MenuItem Header="_Affichage">
                                <MenuItem Header="_Palette de commandes..." InputGestureText="Ctrl+Maj+P" Click="PaletteCommandes_Click"/>
                                <MenuItem Header="Accès _rapide aux fichiers..." InputGestureText="Ctrl+P" Click="PaletteFichiers_Click"/>
                                <MenuItem Header="_Extensions" InputGestureText="Ctrl+Maj+X" Click="Extensions_Click"/>
                                <Separator/>
                                <MenuItem Header="_Thème">
                                    <MenuItem Header="Sombre+ (VS Code)" Click="ThemeSombre_Click"/>
                                    <MenuItem Header="Clair+ (VS Code)" Click="ThemeClair_Click"/>
                                    <MenuItem Header="One Dark Pro" Click="ThemeOneDark_Click"/>
                                </MenuItem>
                                <MenuItem Header="_Zoom">
                                    <MenuItem Header="Agrandir" Click="ZoomPlus_Click"/>
                                    <MenuItem Header="Réduire" Click="ZoomMoins_Click"/>
                                    <MenuItem Header="Taille normale" Click="ZoomNormal_Click"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Afficher/masquer l'_explorateur" InputGestureText="Ctrl+Maj+E" Click="BasculerExplorateur_Click"/>
                                <MenuItem Header="Afficher/masquer le _terminal" InputGestureText="Ctrl+J" Click="BasculerTerminal_Click"/>
                                <MenuItem Header="Afficher/masquer _Gemini AI" InputGestureText="Ctrl+Alt+I" Click="BasculerIA_Click"/>
                            </MenuItem>
                            <MenuItem Header="E_xécuter">
                                <MenuItem Header="_Exécuter le fichier" InputGestureText="F5" Click="Executer_Click"/>
                                <MenuItem x:Name="MenuCodeRunner" Header="Code Runner : exécuter la sélection"
                                          InputGestureText="Ctrl+Alt+N" Click="CodeRunner_Click" Visibility="Collapsed"/>
                                <MenuItem Header="_Arrêter" Click="Arreter_Click"/>
                                <MenuItem Header="_Effacer la sortie" Click="EffacerTerminal_Click"/>
                                <Separator/>
                                <MenuItem Header="Ouvrir le _Terminal PowerShell" Click="OuvrirShell_Click"/>
                                <MenuItem Header="Voir les _Problèmes" Click="OuvrirProblemes_Click"/>
                            </MenuItem>
                            <MenuItem Header="_Gemini AI">
                                <MenuItem Header="Ouvrir / masquer le panneau _Gemini" InputGestureText="Ctrl+Alt+I" Click="BasculerIA_Click"/>
                                <MenuItem Header="_Expliquer le fichier actif" Click="ExpliquerIA_Click"/>
                                <MenuItem Header="_Corriger les erreurs avec Gemini" Click="CorrigerIA_Click"/>
                                <Separator/>
                                <MenuItem Header="Configurer la _clé API Gemini..." Click="Parametres_Click"/>
                            </MenuItem>
                            <MenuItem Header="_Aide">
                                <MenuItem Header="_Raccourcis clavier" Click="Raccourcis_Click"/>
                                <MenuItem Header="À _propos" Click="APropos_Click"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Barre de recherche rapide centrée façon VS Code -->
                    <Button x:Name="BoutonBarreRecherche" Grid.Column="1"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            MaxWidth="420" Height="22" Margin="16,0"
                            Background="{DynamicResource ThemeSaisieFond}"
                            BorderBrush="{DynamicResource ThemeBordure}" BorderThickness="1"
                            Cursor="Hand" Focusable="False"
                            Click="PaletteFichiers_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Fond" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="12,0">
                                    <TextBlock x:Name="TexteTitreBarre" Text="🔍  KeyceCode — Rechercher un fichier (Ctrl+P)"
                                               Foreground="{DynamicResource ThemeTexteSecondaire}"
                                               FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Fond" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Boutons de fenêtre -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" ToolTip="Réduire" Style="{StaticResource BoutonFenetre}" Click="ReduireFenetre_Click"/>
                        <Button x:Name="BoutonAgrandir" Content="☐" ToolTip="Agrandir / Restaurer" Style="{StaticResource BoutonFenetre}" Click="AgrandirFenetre_Click"/>
                        <Button Content="✕" ToolTip="Fermer" Style="{StaticResource BoutonFermerFenetre}" Click="Quitter_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Barre de statut VS Code -->
            <StatusBar DockPanel.Dock="Bottom" Height="24">
                <StatusBarItem>
                    <TextBlock x:Name="StatutDossier" Text="Aucun dossier" Margin="4,0"/>
                </StatusBarItem>
                <StatusBarItem>
                    <Button x:Name="BoutonStatutProblemes" Content="⊗ 0   ⚠ 0"
                            Style="{StaticResource BoutonStatut}"
                            ToolTip="Afficher le panneau Problèmes"
                            Click="OuvrirProblemes_Click"/>
                </StatusBarItem>

                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatutPosition" Text="Ln 1, Col 1" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatutIndentation" Text="Espaces: 4" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatutEncodage" Text="UTF-8" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatutLangage" Text="Texte brut" Margin="8,0" VerticalAlignment="Center"/>
                        <Button x:Name="BoutonStatutZoom" Content="100%" Style="{StaticResource BoutonStatut}"
                                ToolTip="Réinitialiser le zoom" Click="ZoomNormal_Click"/>
                        <Button x:Name="BoutonStatutTheme" Content="Sombre" Style="{StaticResource BoutonStatut}"
                                ToolTip="Basculer Clair / Sombre" Click="BasculerTheme_Click"/>
                        <Button x:Name="BoutonGoLive" Content="◉ Go Live" Style="{StaticResource BoutonStatut}"
                                Visibility="Collapsed" ToolTip="Démarrer Live Server" Click="GoLive_Click"/>
                        <Button Content="✦ Gemini" Style="{StaticResource BoutonStatut}"
                                ToolTip="Ouvrir l'assistant Gemini (Ctrl+Alt+I)" Click="BasculerIA_Click"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            <!-- Corps principal : Barre d'activité + Explorateur + Éditeur/Terminal + Gemini AI -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition x:Name="ColonneGauche" Width="260"/>
                    <ColumnDefinition x:Name="ColonneSeparateurGauche" Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Barre d'activité VS Code (icônes vectorielles) -->
                <Border Grid.Column="0"
                        Background="{DynamicResource ThemeBarreActivite}"
                        BorderBrush="{DynamicResource ThemeBordure}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <Button x:Name="ActExplorateur" ToolTip="Explorateur (Ctrl+Maj+E)"
                                    Style="{StaticResource BoutonBarreActivite}" Tag="Actif"
                                    Click="ActiviteExplorateur_Click">
                                <Path Data="M3,3 L9,3 L11,5 L19,5 L19,17 L3,17 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="22" Height="20" Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="ActRecherche" ToolTip="Rechercher dans les fichiers (Ctrl+Maj+F)"
                                    Style="{StaticResource BoutonBarreActivite}"
                                    Click="ActiviteRecherche_Click">
                                <Path Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L20,20"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="ActExtensions" ToolTip="Extensions (Ctrl+Maj+X)"
                                    Style="{StaticResource BoutonBarreActivite}"
                                    Click="ActiviteExtensions_Click">
                                <Grid Width="24" Height="24">
                                    <!-- Quatre carrés dont un décalé en haut à droite -->
                                    <Path Data="M3,13.5 H10 V20.5 H3 Z M12,13.5 H19 V20.5 H12 Z M3,4.5 H10 V11.5 H3 Z M13.5,2.5 H20.5 V9.5 H13.5 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" Stretch="None"/>
                                    <!-- Badge de rotation (visible pendant une installation / actualisation) -->
                                    <Border x:Name="BadgeExtensions" Visibility="Collapsed"
                                            Width="14" Height="14" CornerRadius="7"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-7,-5"
                                            Background="{DynamicResource ThemeAccent}"
                                            BorderBrush="{DynamicResource ThemeBarreActivite}" BorderThickness="1.5">
                                        <Path Data="M13,8 A5,5 0 1 1 11.2,4.2 M11.6,1.8 V4.6 H8.8"
                                              Stroke="White" StrokeThickness="2" Width="7" Height="7" Stretch="Uniform"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="RotationBadge"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                </Grid>
                            </Button>

                            <Button x:Name="ActExecuter" ToolTip="Exécuter le fichier actif (F5)"
                                    Style="{StaticResource BoutonBarreActivite}"
                                    Click="Executer_Click">
                                <Path Data="M6,4 L18,11 L6,18 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="ActProblemes" ToolTip="Problèmes et Terminal (Ctrl+J)"
                                    Style="{StaticResource BoutonBarreActivite}"
                                    Click="BasculerTerminal_Click">
                                <Path Data="M3,5 L21,5 L21,19 L3,19 Z M6,10 L10,13 L6,16 M11,16 L17,16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="20" Height="18" Stretch="Uniform"/>
                            </Button>

                            <Button x:Name="ActGemini" ToolTip="Gemini (Ctrl+Alt+I)"
                                    Style="{StaticResource BoutonBarreActivite}"
                                    Click="BasculerIA_Click">
                                <Path Data="{StaticResource GeminiLogoGeometry}"
                                      Fill="{StaticResource GeminiLogoBrush}"
                                      Width="20" Height="20" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                            <Button ToolTip="Basculer Thème Clair / Sombre"
                                    Style="{StaticResource BoutonBarreActivite}"
                                    Click="BasculerTheme_Click">
                                <Path Data="M12,3 A9,9 0 1 0 21,12 A7,7 0 1 1 12,3 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                            <Button ToolTip="Paramètres (police, thème, clé API Gemini)"
                                    Style="{StaticResource BoutonBarreActivite}"
                                    Click="Parametres_Click">
                                <Path Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M5,5 L7,7 M17,17 L19,19 M19,5 L17,7 M7,17 L5,19"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="Transparent" Width="19" Height="19" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Panneau gauche : Explorateur + Recherche globale -->
                <Grid x:Name="PanneauGauche" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ctl:ExplorateurControl x:Name="Explorateur" Grid.Row="0"/>
                    <ctl:RechercheFichiersControl x:Name="RechercheFichiers" Grid.Row="1"
                                                  Height="260" Visibility="Collapsed"/>
                    <ctl:ExtensionsControl x:Name="PanneauExtensions" Grid.Row="0" Grid.RowSpan="2"
                                           Visibility="Collapsed"/>
                    <ctl:AssistantIAControl x:Name="AssistantIA" Grid.Row="0" Grid.RowSpan="2"
                                            Visibility="Collapsed"/>
                </Grid>

                <GridSplitter x:Name="SeparateurGauche" Grid.Column="2" Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Zone centrale : Onglets + Recherche + Terminal/Problèmes -->
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="LigneSeparateurBas" Height="4"/>
                        <RowDefinition x:Name="LigneBas" Height="210"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <ctl:OngletsControl x:Name="Onglets"/>
                        <ctl:RechercheControl x:Name="Recherche"/>
                        <ctl:ExtensionDetailControl x:Name="DetailExtension" Visibility="Collapsed"/>
                    </Grid>

                    <GridSplitter x:Name="SeparateurBas" Grid.Row="1" Height="4"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <ctl:TerminalControl x:Name="Terminal" Grid.Row="2"/>
                </Grid>

                <!-- Palette de commandes (Ctrl+P / Ctrl+Maj+P) -->
                <ctl:PaletteCommandesControl x:Name="Palette" Grid.Column="1" Grid.ColumnSpan="3"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
