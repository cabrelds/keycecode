<Window x:Class="KeyCode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:KeyCode.Controls"
        Title="KeyCode" Height="700" Width="1100"
        AllowDrop="True" Drop="Fenetre_Drop"
        PreviewKeyDown="Fenetre_PreviewKeyDown"
        Closing="Fenetre_Closing">
    <DockPanel>
        <!-- Menus -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Nouveau" InputGestureText="Ctrl+N" Click="Nouveau_Click"/>
                <MenuItem Header="_Ouvrir un fichier..." InputGestureText="Ctrl+O" Click="Ouvrir_Click"/>
                <MenuItem Header="Ouvrir un _dossier..." Click="OuvrirDossier_Click"/>
                <Separator/>
                <MenuItem Header="_Enregistrer" InputGestureText="Ctrl+S" Click="Enregistrer_Click"/>
                <MenuItem Header="Tout enregistrer" Click="ToutEnregistrer_Click"/>
                <Separator/>
                <MenuItem Header="_Fermer l'onglet" InputGestureText="Ctrl+W" Click="FermerOnglet_Click"/>
                <MenuItem x:Name="MenuRecents" Header="Fichiers _récents"/>
                <Separator/>
                <MenuItem Header="_Quitter" Click="Quitter_Click"/>
            </MenuItem>
            <MenuItem Header="_Édition">
                <MenuItem Header="_Annuler" InputGestureText="Ctrl+Z" Click="Annuler_Click"/>
                <MenuItem Header="_Rétablir" InputGestureText="Ctrl+Y" Click="Retablir_Click"/>
                <Separator/>
                <MenuItem Header="Co_uper" InputGestureText="Ctrl+X" Click="Couper_Click"/>
                <MenuItem Header="_Copier" InputGestureText="Ctrl+C" Click="Copier_Click"/>
                <MenuItem Header="C_oller" InputGestureText="Ctrl+V" Click="Coller_Click"/>
                <Separator/>
                <MenuItem Header="Tout _sélectionner" InputGestureText="Ctrl+A" Click="ToutSelectionner_Click"/>
                <Separator/>
                <MenuItem Header="_Rechercher" InputGestureText="Ctrl+F" Click="Rechercher_Click"/>
                <MenuItem Header="Re_mplacer" InputGestureText="Ctrl+H" Click="Remplacer_Click"/>
                <MenuItem Header="Rechercher dans les _fichiers" InputGestureText="Ctrl+Maj+F" Click="RechercheFichiers_Click"/>
            </MenuItem>
            <MenuItem Header="_Affichage">
                <MenuItem Header="_Thème">
                    <MenuItem Header="Clair" Click="ThemeClair_Click"/>
                    <MenuItem Header="Sombre" Click="ThemeSombre_Click"/>
                </MenuItem>
                <MenuItem Header="_Zoom">
                    <MenuItem Header="Agrandir" Click="ZoomPlus_Click"/>
                    <MenuItem Header="Réduire" Click="ZoomMoins_Click"/>
                    <MenuItem Header="Taille normale" Click="ZoomNormal_Click"/>
                </MenuItem>
                <MenuItem Header="Afficher/masquer l'_explorateur" Click="BasculerExplorateur_Click"/>
                <MenuItem Header="Afficher/masquer le _terminal" Click="BasculerTerminal_Click"/>
            </MenuItem>
            <MenuItem Header="E_xécuter">
                <MenuItem Header="_Exécuter le fichier" InputGestureText="F5" Click="Executer_Click"/>
                <MenuItem Header="_Arrêter" Click="Arreter_Click"/>
                <MenuItem Header="_Effacer le terminal" Click="EffacerTerminal_Click"/>
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem Header="_Raccourcis clavier" Click="Raccourcis_Click"/>
                <MenuItem Header="À _propos" Click="APropos_Click"/>
            </MenuItem>
        </Menu>

        <!-- Barre de statut -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatutPosition" Text="Ln 1, Col 1"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatutLangage" Text="Texte brut"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatutEncodage" Text="UTF-8"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Terminal (TerminalControl) -->
        <ctl:TerminalControl x:Name="Terminal" DockPanel.Dock="Bottom" Height="200"/>

        <!-- Partie principale : explorateur à gauche, onglets à droite -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColonneGauche" Width="260"/>
                <ColumnDefinition x:Name="ColonneSeparateur" Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Gauche : explorateur + recherche dans les fichiers (masquée au départ) -->
            <Grid x:Name="PanneauGauche" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ctl:ExplorateurControl x:Name="Explorateur" Grid.Row="0"/>
                <ctl:RechercheFichiersControl x:Name="RechercheFichiers" Grid.Row="1"
                                              Height="260" Visibility="Collapsed"/>
            </Grid>

            <GridSplitter x:Name="SeparateurGauche" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Onglets (OngletsControl) + barre de recherche (RechercheControl) par-dessus.
                 La marge du haut laisse visible la barre d'onglets, comme dans VS Code. -->
            <Grid Grid.Column="2">
                <ctl:OngletsControl x:Name="Onglets"/>
                <ctl:RechercheControl x:Name="Recherche" Margin="0,36,24,0"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>