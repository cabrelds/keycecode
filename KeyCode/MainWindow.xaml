<Window x:Class="KeyCode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="KeyCode" Height="600" Width="900">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Ouvrir..." Click="Ouvrir_Click"/>
                <MenuItem Header="_Enregistrer" Click="Enregistrer_Click"/>
            </MenuItem>
            <MenuItem Header="_Exécuter" Click="Executer_Click"/>
        </Menu>
        <DockPanel DockPanel.Dock="Bottom" Height="170">
            <TextBox x:Name="Saisie" DockPanel.Dock="Bottom" FontFamily="Consolas"
                     Background="#2D2D2D" Foreground="White" CaretBrush="White"
                     KeyDown="Saisie_KeyDown"/>
            <TextBox x:Name="Sortie" IsReadOnly="True" FontFamily="Consolas"
                     Background="#1E1E1E" Foreground="White"
                     VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
        <avalon:TextEditor x:Name="Editeur" ShowLineNumbers="True"
                           FontFamily="Consolas" FontSize="14"/>
    </DockPanel>
</Window>