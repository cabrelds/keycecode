<UserControl x:Class="KeyCode.Controls.OngletsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OngletsControl_Loaded"
             Unloaded="OngletsControl_Unloaded">
    <UserControl.Resources>
        <!-- Style des boutons d'action dans la barre d'onglets ('+' et '▾') -->
        <Style x:Key="BoutonBarreOnglets" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="{DynamicResource ThemeSurvol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style du bouton de fermeture '✕' sur chaque onglet -->
        <Style x:Key="BoutonFermerOnglet" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="{DynamicResource ThemeSurvol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style moderne des onglets VS Code -->
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="{DynamicResource ThemeFondTertiaire}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexteSecondaire}"/>
            <Setter Property="Padding" Value="8,6,6,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="FondOnglet"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ThemeBordure}"
                                BorderThickness="0,0,1,0">
                            <Grid>
                                <Border x:Name="BarreAccent" Height="2" VerticalAlignment="Top"
                                        Background="Transparent"/>
                                <ContentPresenter ContentSource="Header"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FondOnglet" Property="Background" Value="{DynamicResource ThemeSurvol}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
                                <Setter TargetName="FondOnglet" Property="Background" Value="{DynamicResource ThemeFond}"/>
                                <Setter TargetName="BarreAccent" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ThemeFond}">
        <!-- TabControl contenant un éditeur AvalonEdit (ou visionneur) par onglet -->
        <TabControl x:Name="Onglets"
                    BorderThickness="0"
                    Padding="0"
                    Background="{DynamicResource ThemeFond}"
                    SelectionChanged="Onglets_SelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barre supérieure : onglets défilables + liste rapide + bouton '+' -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource ThemeFondSecondaire}"
                                BorderBrush="{DynamicResource ThemeBordure}"
                                BorderThickness="0,0,0,1"
                                MouseLeftButtonDown="BarreOnglets_MouseLeftButtonDown">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="+"
                                        Margin="0,2,4,2"
                                        ToolTip="Nouvel onglet (Ctrl+N)"
                                        Style="{StaticResource BoutonBarreOnglets}"
                                        Click="BoutonNouveau_Click"/>

                                <Button DockPanel.Dock="Right"
                                        Content="▾"
                                        FontSize="11"
                                        ToolTip="Liste des onglets ouverts"
                                        Style="{StaticResource BoutonBarreOnglets}"
                                        Click="BoutonListeOnglets_Click"/>

                                <ScrollViewer x:Name="DefileurOnglets"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Focusable="False"
                                              PreviewMouseWheel="DefileurOnglets_PreviewMouseWheel">
                                    <TabPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Fil d'Ariane (Breadcrumb) comme dans VS Code -->
                        <Border x:Name="BarreFilAriane" Grid.Row="1"
                                Background="{DynamicResource ThemeFond}"
                                BorderBrush="{DynamicResource ThemeBordure}"
                                BorderThickness="0,0,0,1"
                                Padding="12,3"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TexteFilAriane"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTexteSecondaire}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- Contenu de l'onglet actif -->
                        <Border Grid.Row="2" Background="{DynamicResource ThemeFond}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>

        <!-- État d'accueil VS Code lorsque tous les onglets sont fermés -->
        <StackPanel x:Name="PanneauVide"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="KeyCode"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="{DynamicResource ThemeTexteSecondaire}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Ctrl+N : Nouveau  •  Ctrl+O : Ouvrir  •  Ctrl+P : Accès rapide  •  Ctrl+Maj+P : Commandes  •  F5 : Exécuter"
                       FontSize="12"
                       Foreground="{DynamicResource ThemeTexteSecondaire}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Nouveau fichier"
                        Margin="0,0,8,0"
                        Style="{StaticResource BoutonPrimaireVsCode}"
                        Click="BoutonNouveau_Click"/>
                <Button Content="Rouvrir fermé (Ctrl+Maj+T)"
                        Style="{StaticResource BoutonSecondaireVsCode}"
                        Click="BoutonRouvrir_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
