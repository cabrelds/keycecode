<UserControl x:Class="KeyCode.Controls.TerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="TerminalControl_Loaded"
             Unloaded="TerminalControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="OngletBas" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexteSecondaire}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
                                <Setter TargetName="Fond" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonBarreBas" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTexte}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="{DynamicResource ThemeSurvol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ThemeTerminalFond}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre d'onglets inférieure : PROBLÈMES | EXÉCUTION | TERMINAL -->
        <Border Grid.Row="0"
                Background="{DynamicResource ThemeFondSecondaire}"
                BorderBrush="{DynamicResource ThemeBordure}"
                BorderThickness="0,1,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="6,0,0,0">
                    <RadioButton x:Name="OngletProblemes" GroupName="PanneauBas"
                                 Content="PROBLÈMES (0)" Style="{StaticResource OngletBas}"
                                 Checked="OngletBas_Checked"/>
                    <RadioButton x:Name="OngletExecution" GroupName="PanneauBas"
                                 Content="EXÉCUTION" Style="{StaticResource OngletBas}"
                                 IsChecked="True" Checked="OngletBas_Checked"/>
                    <RadioButton x:Name="OngletShell" GroupName="PanneauBas"
                                 Content="TERMINAL" Style="{StaticResource OngletBas}"
                                 Checked="OngletBas_Checked"/>
                </StackPanel>

                <Button x:Name="BoutonFermerPanneau" Content="✕" ToolTip="Masquer le panneau"
                        DockPanel.Dock="Right" Style="{StaticResource BoutonBarreBas}"
                        Click="FermerPanneau_Click"/>
                <Button Content="Effacer" ToolTip="Vider la vue active"
                        DockPanel.Dock="Right" Style="{StaticResource BoutonBarreBas}"
                        Click="Effacer_Click"/>
                <Button x:Name="BoutonArreter" Content="Arrêter" ToolTip="Arrêter l'exécution en cours"
                        DockPanel.Dock="Right" Style="{StaticResource BoutonBarreBas}"
                        Click="Arreter_Click"/>
                <Button x:Name="BoutonDemanderGemini" Content="✦ Corriger avec Gemini"
                        ToolTip="Analyser la dernière erreur dans l'assistant Gemini"
                        DockPanel.Dock="Right" Style="{StaticResource BoutonBarreBas}"
                        Visibility="Collapsed" Click="DemanderGemini_Click"/>
            </DockPanel>
        </Border>

        <!-- Vue 1 : PROBLÈMES -->
        <Grid x:Name="VueProblemes" Grid.Row="1" Visibility="Collapsed"
              Background="{DynamicResource ThemeTerminalFond}">
            <ListBox x:Name="ListeProblemes"
                     Background="Transparent"
                     BorderThickness="0"
                     MouseDoubleClick="ListeProblemes_DoubleClick"
                     PreviewKeyDown="ListeProblemes_PreviewKeyDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Aller à l'erreur" Click="AllerAuProbleme_Click"/>
                        <MenuItem Header="✦ Corriger avec Gemini" Click="CorrigerProblemeGemini_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <TextBlock x:Name="TexteAucunProbleme"
                       Text="Aucun problème détecté dans les fichiers ouverts."
                       Foreground="{DynamicResource ThemeTexteSecondaire}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12"/>
        </Grid>

        <!-- Vue 2 : EXÉCUTION (sortie colorée + liens cliquables + stdin) -->
        <Grid x:Name="VueExecution" Grid.Row="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <RichTextBox x:Name="Sortie" Grid.Row="0" IsReadOnly="True"
                         IsDocumentEnabled="True"
                         Background="{DynamicResource ThemeTerminalFond}"
                         Foreground="{DynamicResource ThemeTerminalTexte}"
                         BorderThickness="0"
                         FontFamily="Consolas" FontSize="13" Padding="10,6"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto">
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="LineHeight" Value="18"/>
                    </Style>
                </RichTextBox.Resources>
                <FlowDocument x:Name="DocumentSortie" PageWidth="2000"/>
            </RichTextBox>

            <Border Grid.Row="1"
                    Background="{DynamicResource ThemeFondSecondaire}"
                    BorderBrush="{DynamicResource ThemeBordure}"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="10,5">
                    <TextBlock Text="&gt;" DockPanel.Dock="Left"
                               Foreground="{DynamicResource ThemeSucces}"
                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="Saisie" Background="Transparent"
                             Foreground="{DynamicResource ThemeTexte}"
                             CaretBrush="{DynamicResource ThemeTexte}"
                             BorderThickness="0"
                             FontFamily="Consolas" FontSize="13"
                             ToolTip="Saisir une réponse pour input() / scanf() et appuyer sur Entrée"
                             PreviewKeyDown="Saisie_PreviewKeyDown"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Vue 3 : TERMINAL INTERACTIF (PowerShell) -->
        <Grid x:Name="VueShell" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SortieShell" Grid.Row="0" IsReadOnly="True"
                     Background="{DynamicResource ThemeTerminalFond}"
                     Foreground="{DynamicResource ThemeTerminalTexte}"
                     BorderThickness="0"
                     FontFamily="Consolas" FontSize="13" Padding="10,6"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <Border Grid.Row="1"
                    Background="{DynamicResource ThemeFondSecondaire}"
                    BorderBrush="{DynamicResource ThemeBordure}"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="10,5">
                    <TextBlock Text="PS &gt;" DockPanel.Dock="Left"
                               Foreground="{DynamicResource ThemeAccent}"
                               FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SaisieShell" Background="Transparent"
                             Foreground="{DynamicResource ThemeTexte}"
                             CaretBrush="{DynamicResource ThemeTexte}"
                             BorderThickness="0"
                             FontFamily="Consolas" FontSize="13"
                             ToolTip="Taper une commande PowerShell / Git / Python / Dotnet et appuyer sur Entrée"
                             PreviewKeyDown="SaisieShell_PreviewKeyDown"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
