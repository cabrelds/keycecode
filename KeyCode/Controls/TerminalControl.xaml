<UserControl x:Class="KeyCode.Controls.TerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="BoutonEntete" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="#3C3C3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête : titre + boutons -->
        <DockPanel Grid.Row="0" Background="#252526" LastChildFill="False">
            <TextBlock Text="TERMINAL" DockPanel.Dock="Left" Foreground="#CCCCCC"
                       FontSize="11" FontWeight="SemiBold" Margin="12,0"
                       VerticalAlignment="Center"/>
            <Button Content="Effacer" DockPanel.Dock="Right"
                    Style="{StaticResource BoutonEntete}" Click="Effacer_Click"/>
            <Button Content="Arrêter" DockPanel.Dock="Right"
                    Style="{StaticResource BoutonEntete}" Click="Arreter_Click"/>
        </DockPanel>

        <!-- Zone de sortie en direct -->
<TextBox x:Name="Sortie" Grid.Row="1" IsReadOnly="True"
                 Background="#1E1E1E" Foreground="#CCCCCC" BorderThickness="0"
                 FontFamily="Consolas" FontSize="13" Padding="12,8"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 SelectionBrush="#264F78"/>

        <!-- Ligne de saisie -->
        <Border Grid.Row="2" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,6">
                <TextBlock Text="&gt;" DockPanel.Dock="Left" Foreground="#6A9955"
                           FontFamily="Consolas" FontSize="13" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="Saisie" Background="Transparent" Foreground="#CCCCCC"
                         CaretBrush="#CCCCCC" BorderThickness="0"
                         FontFamily="Consolas" FontSize="13"
                         PreviewKeyDown="Saisie_PreviewKeyDown"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>